@SET SYSNAME 2_labeling__R_PADDEDSTEP_

&GLOBAL
 PRINT_LEVEL LOW
 PROJECT ${SYSNAME}
 RUN_TYPE ENERGY_FORCE
 PREFERRED_DIAG_LIBRARY ScaLAPACK
&END GLOBAL

&FORCE_EVAL
 METHOD QS
 &DFT
  BASIS_SET_FILE_NAME GTH_BASIS_SETS
  POTENTIAL_FILE_NAME GTH_POTENTIALS
  WFN_RESTART_FILE_NAME labeling__R_PADDEDSTEP_-SCF.wfn
  CHARGE -1
  LSD
  MULTIPLICITY 2

    &QS
        METHOD GPW 
        EPS_DEFAULT 1.0E-10
        EPS_PGF_ORB 1.0E-15
        EXTRAPOLATION ASPC
    &END  

  &MGRID
    CUTOFF 600
    REL_CUTOFF 50
    NGRIDS 5
  &END MGRID

  &POISSON
       PERIODIC XYZ 
    &END

  &SCF
   MAX_SCF 300
   EPS_SCF 1e-6
   SCF_GUESS RESTART

    &OT
    PRECONDITIONER  FULL_SINGLE_INVERSE
    MINIMIZER       DIIS
        N_HISTORY_VEC	7
    &END OT

   &PRINT
    &RESTART
     FILENAME =2_labeling__R_PADDEDSTEP_-SCF.wfn
     LOG_PRINT_KEY
     BACKUP_COPIES 0
     &EACH
      QS_SCF 0
      JUST_ENERGY 1
     &END EACH
     COMMON_ITERATION_LEVELS 1
     ADD_LAST NUMERIC
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
   &END PRINT
  &END SCF

    &XC
      &XC_FUNCTIONAL  
       &PBE
         SCALE_X   0.60
       &END PBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION        0.40
        &SCREENING
          EPS_SCHWARZ 1.0E-6
          SCREEN_ON_INITIAL_P TRUE
        &END
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE TRUNCATED
          CUTOFF_RADIUS  1.5
        &END
      &END
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          R_CUTOFF             12.0
          TYPE                 DFTD3
          PARAMETER_FILE_NAME  dftd3.dat
          REFERENCE_FUNCTIONAL PBE0
          VERBOSE_OUTPUT
        &END
      &END VDW_POTENTIAL
    &END XC
 &END DFT


 &SUBSYS
  &CELL 
      ABC [angstrom] 12.43 12.43 12.43
    &END CELL
  &TOPOLOGY
   COORD_FILE_FORMAT XYZ
   COORD_FILE_NAME labeling__R_PADDEDSTEP_.xyz
  &END TOPOLOGY
    &KIND H
      BASIS_SET           TZVP-GTH
      POTENTIAL           GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET           TZVP-GTH
      POTENTIAL           GTH-PBE-q6
    &END KIND
 &END SUBSYS
 &PRINT
    &PROGRAM_RUN_INFO
      FILENAME =${SYSNAME}-Force_Eval.fe
      LOG_PRINT_KEY
      &EACH
        JUST_ENERGY 1
      &END EACH
      ADD_LAST NUMERIC
    &END PROGRAM_RUN_INFO
    &FORCES
      FILENAME =${SYSNAME}-Forces.for
      LOG_PRINT_KEY
      &EACH
        JUST_ENERGY 1
      &END EACH
      ADD_LAST NUMERIC
    &END FORCES
  &END PRINT
&END FORCE_EVAL
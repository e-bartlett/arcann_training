@SET SYSNAME 1_labeling__R_PADDEDSTEP_

&GLOBAL
 PRINT_LEVEL LOW
 PREFERRED_FFT_LIBRARY FFTW3
 EXTENDED_FFT_LENGTHS FALSE
 PROJECT ${SYSNAME}
 RUN_TYPE ENERGY_FORCE
 PREFERRED_DIAG_LIBRARY ScaLAPACK
&END GLOBAL

&FORCE_EVAL
 METHOD QS

 &DFT
  BASIS_SET_FILE_NAME   GTH_BASIS_SETS
  BASIS_SET_FILE_NAME   BASIS_ADMM
  POTENTIAL_FILE_NAME   GTH_POTENTIALS
  WFN_RESTART_FILE_NAME labeling__R_PADDEDSTEP_-SCF.wfn
  CHARGE -1
  MULTIPLICITY 2
  LSD

  &MGRID
    CUTOFF 600
    REL_CUTOFF 50
    NGRIDS 5
  &END MGRID

  &AUXILIARY_DENSITY_MATRIX_METHOD
  &END

  &POISSON
    PERIODIC     XYZ 
  &END
  
  &SCF
   MAX_SCF 300
   EPS_SCF 1e-6
   SCF_GUESS RESTART

   &OT
    PRECONDITIONER  FULL_SINGLE_INVERSE
    MINIMIZER       DIIS
	  N_HISTORY_VEC	7
   &END OT

   &PRINT
     &RESTART
       FILENAME =labeling__R_PADDEDSTEP_-SCF.wfn
       LOG_PRINT_KEY
       BACKUP_COPIES 0
       &EACH
         QS_SCF 0
         JUST_ENERGY 1
       &END EACH
       COMMON_ITERATION_LEVELS 1
       ADD_LAST NUMERIC
     &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
   &END PRINT

  &END SCF

  &QS
   METHOD GPW
   EPS_DEFAULT 1.0E-14
   EPS_PGF_ORB 1.0E-15
   EXTRAPOLATION ASPC
   EXTRAPOLATION_ORDER 3
  &END QS

  &XC
    &XC_FUNCTIONAL  
      &PBE
        SCALE_X   0.60
      &END PBE
    &END XC_FUNCTIONAL
    &HF
      FRACTION        0.40
      &SCREENING
        EPS_SCHWARZ 1.0E-6
        SCREEN_ON_INITIAL_P TRUE
      &END
      &INTERACTION_POTENTIAL
        POTENTIAL_TYPE TRUNCATED
        CUTOFF_RADIUS  1.5
      &END
    &END
    &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          R_CUTOFF             12.0
          TYPE                 DFTD3
          PARAMETER_FILE_NAME  dftd3.dat
          REFERENCE_FUNCTIONAL PBE0
          VERBOSE_OUTPUT
        &END
    &END VDW_POTENTIAL
  &END XC
  &PRINT
    &E_DENSITY_CUBE ON
      STRIDE 4 4 4
    &END E_DENSITY_CUBE
  &END PRINT
 &END DFT

 &SUBSYS
  &CELL
   ABC 12.43 12.43 12.43
  &END CELL
  &TOPOLOGY
   COORD_FILE_FORMAT XYZ
   COORD_FILE_NAME labeling__R_PADDEDSTEP_.xyz
  &END TOPOLOGY
  &KIND H
      BASIS_SET           TZVP-GTH
      POTENTIAL           GTH-PBE-q1
      BASIS_SET AUX_FIT   cFIT3
    &END KIND
    &KIND O
      BASIS_SET           TZVP-GTH
      POTENTIAL           GTH-PBE-q6
      BASIS_SET AUX_FIT   cFIT3
    &END KIND
 &END SUBSYS
&END FORCE_EVAL